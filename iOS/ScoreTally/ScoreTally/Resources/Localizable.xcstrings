    "delete-game-confirmation-message" : {
      "comment" : "Explains the consequences of deleting a game",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف لاعبوها ونقاطها وجولاتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spieler, Punkte und Runden werden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its players, scores and rounds will be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán sus jugadores, puntuaciones y rondas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán sus jugadores, puntuaciones y rondas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses joueurs, scores et tours seront supprimés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses joueurs, pointages et tours seront supprimés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השחקנים, הניקוד והסבבים שלו יימחקו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके खिलाड़ी, स्कोर और राउंड हटा दिए जाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giocatori, i punteggi e i turni verranno eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤー、スコア、ラウンドがすべて削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어, 점수 및 라운드가 모두 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De spelers, scores en rondes worden verwijderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogadores, as pontuações e as rodadas serão apagados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os jogadores, as pontuações e as rondas serão apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игроки, очки и раунды будут удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其玩家、分数和轮次都将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其玩家、分數和輪次都將被刪除。"
          }
        }
      }
    },
