        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सहेजे गए गेम लोड नहीं हो सके। उन्हें हटाया नहीं गया है। ऐप अपडेट करें और फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare i giochi salvati. Non sono stati eliminati. Aggiorna l'app e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したゲームを読み込めませんでした。ゲームは削除されていません。アプリをアップデートしてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 게임을 불러올 수 없습니다. 게임은 삭제되지 않았습니다. 앱을 업데이트한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opgeslagen spellen konden niet worden geladen. Ze zijn niet verwijderd. Werk de app bij en probeer het opnieuw."
