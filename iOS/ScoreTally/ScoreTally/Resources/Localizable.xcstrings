    "store-error-description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل ألعابك المحفوظة، لكنها لم تُحذف. حدّث التطبيق وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespeicherten Spiele konnten nicht geladen werden. Sie wurden nicht gelöscht. Aktualisiere die App und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved games couldn't be loaded. They haven't been deleted. Update the app and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar tus juegos guardados. No se han eliminado. Actualiza la app e inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar tus juegos guardados. No se eliminaron. Actualiza la app e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jeux enregistrés n'ont pas pu être chargés. Ils n'ont pas été supprimés. Mettez l'app à jour et réessayez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos jeux enregistrés n'ont pas pu être chargés. Ils n'ont pas été supprimés. Mettez l'app à jour et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לטעון את המשחקים השמורים, אבל הם לא נמחקו. יש לעדכן את האפליקציה ולנסות שוב."
